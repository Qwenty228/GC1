# Copy this file to `.env` and fill in your values. Never commit `.env`.
# The only AI credential is ANTHROPIC_API_KEY, used ONLY when semantic event
# grouping is enabled (SIMILARITY_ENABLED=true, see the last section).

# --- Alpaca authentication -------------------------------------------------
# trading (default): Trading API keys sent as APCA-API-KEY-ID / APCA-API-SECRET-KEY.
# broker: OAuth2 client-credentials token (Authorization: Bearer), cached ~15 min.
ALPACA_AUTH_MODE=trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Only for ALPACA_AUTH_MODE=broker:
ALPACA_BROKER_CLIENT_ID=
ALPACA_BROKER_CLIENT_SECRET=
# ALPACA_BROKER_TOKEN_URL=https://authx.alpaca.markets/v1/oauth2/token

# Symbols for the standalone stream (datasources-news-stream). The ingestion
# worker uses INGEST_SYMBOLS, falling back to this value, then NVDA.
ALPACA_NEWS_SYMBOLS=NVDA

# --- SEC EDGAR --------------------------------------------------------------
# Required for live SEC access (fair-access policy): "AppName contact@email.com".
SEC_USER_AGENT=YourAppName you@example.com
# Forms to ingest; amendments stay separate filings.
SEC_FORMS=8-K,8-K/A
# Poll each configured company roughly this often (seconds).
SEC_POLL_INTERVAL_SECONDS=60
# Shared budget for ALL SEC requests from the worker (SEC's limit is 10/s; max 5 allowed here).
SEC_REQUESTS_PER_SECOND=2
# First run inspects filings filed within this many days.
SEC_INITIAL_LOOKBACK_DAYS=30
# Recovery never inspects filings older than this many days.
SEC_RECOVERY_MAX_DAYS=365
# Max older submissions files fetched when the recovery range needs them.
SEC_MAX_HISTORICAL_FILES=2
SEC_MAX_RETRIES=3
SEC_MAX_DOCUMENT_BYTES=15728640
SEC_MAX_SUBMISSIONS_BYTES=62914560

# --- Ingestion worker -------------------------------------------------------
INGEST_SYMBOLS=NVDA
# Live output root; demo data always goes to <INGEST_OUTPUT_DIR>/demo.
INGEST_OUTPUT_DIR=output
INGEST_DEMO_MODE=false
INGEST_QUEUE_SIZE=200
HTTP_TIMEOUT_SECONDS=30

# Alpaca REST backfill / reconnect recovery
ALPACA_INITIAL_LOOKBACK_HOURS=24
ALPACA_RECONNECT_OVERLAP_MINUTES=15
ALPACA_RECOVERY_MAX_HOURS=72
ALPACA_BACKFILL_MAX_PAGES=40
# Documented maximum is 50.
ALPACA_PAGE_SIZE=50

# --- Web UI -----------------------------------------------------------------
# true = /api/alpaca serves the bundled SYNTHETIC sample instead of live data.
# Missing credentials are otherwise reported as a configuration error.
DATASOURCES_DEMO_MODE=false

# --- PostgreSQL (news storage) ----------------------------------------------
# Standard libpq variable names, so psql/pgAdmin and this project share one file.
# PGPASSWORD is a real secret: set it in .env only (git-ignored), never here.
PGHOST=localhost
PGPORT=5432
PGDATABASE=stock_news
PGUSER=postgres
PGPASSWORD=
# false = run ingestion without a database (files only).
DATASOURCES_DB_ENABLED=true
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_APPLICATION_NAME=datasources-ingest

# --- Semantic comparison and event grouping (inside the ingestion graph) ------
# Off by default. When true, startup REQUIRES: PostgreSQL + pgvector, migrations
# applied (`uv run datasources-db migrate`), the embedding model downloaded
# (`uv run datasources-similarity download-model`) and comparison credentials.
# Outages later (model, API, retrieval) leave that record's analysis "pending";
# the article itself is always stored.
SIMILARITY_ENABLED=false

# Embeddings. sentence-transformers needs `uv sync --locked --extra local-embeddings`.
# "hashing" is a deterministic word-overlap backend for tests/offline demos only.
SIMILARITY_EMBEDDING_BACKEND=sentence-transformers
SIMILARITY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Pinned Hugging Face commit: the embedding profile identifies exact weights.
SIMILARITY_EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
SIMILARITY_EMBEDDING_DEVICE=cpu
SIMILARITY_EMBEDDING_BATCH_SIZE=16
# Optional model cache directory (default: the standard Hugging Face cache).
SIMILARITY_EMBEDDING_CACHE_DIR=
# Text units (part of the embedding profile: changing them creates new, versioned work).
SIMILARITY_CHUNK_TOKENS=384
SIMILARITY_CHUNK_OVERLAP_TOKENS=48

# LLM comparison. "mock" never calls a model and never links events (every pair
# stays an 'uncertain' pending relation) - for offline demos only.
SIMILARITY_COMPARISON_BACKEND=anthropic
SIMILARITY_COMPARISON_MODEL=claude-opus-5
# Empty = the model's default effort. One of: low, medium, high, xhigh, max.
SIMILARITY_COMPARISON_EFFORT=
# Server-side refusal fallback ("default" re-runs a declined request on the
# recommended fallback model). Set to "none" for models that do not support it.
SIMILARITY_COMPARISON_FALLBACKS=default
# Secret: set in .env only, and only when SIMILARITY_ENABLED=true with the anthropic
# backend. Leave it commented out otherwise: an EMPTY value would shadow a login made
# with `ant auth login`, which the SDK also accepts.
# ANTHROPIC_API_KEY=sk-ant-...
SIMILARITY_LLM_TIMEOUT_SECONDS=180
SIMILARITY_LLM_MAX_RETRIES=2
SIMILARITY_LLM_MAX_OUTPUT_TOKENS=16000
SIMILARITY_LLM_MAX_INPUT_CHARS=30000
SIMILARITY_LLM_MAX_CALLS_PER_RECORD=3
SIMILARITY_LLM_MAX_EVENTS_PER_CALL=6
SIMILARITY_LLM_TOKEN_BUDGET_PER_RECORD=150000

# Retrieval (experimental starting points, not established optimal values).
# Window: +/- days around the record's OWN source time (not the worker clock).
SIMILARITY_WINDOW_DAYS=7
# Without a resolvable company link: no company filter, but a narrower window.
SIMILARITY_NO_COMPANY_WINDOW_HOURS=48
SIMILARITY_SEMANTIC_TOP_K=20
SIMILARITY_LEXICAL_TOP_K=20
SIMILARITY_LEXICAL_MAX_TERMS=48
SIMILARITY_RRF_K=60
SIMILARITY_MAX_CANDIDATE_EVENTS=6
# What may reach the LLM (never what counts as "the same event"): cosine >= the
# floor, or a top-N full-text hit. Scores are not probabilities.
SIMILARITY_MIN_SEMANTIC_SIMILARITY=0.78
SIMILARITY_LEXICAL_PLAUSIBLE_RANK=3
SIMILARITY_MIN_LEXICAL_SCORE=0
# Identical text of at least this many characters links without a model call.
SIMILARITY_EXACT_MATCH_MIN_CHARS=400

# Retry of stored pending analysis (`uv run datasources-similarity retry`).
SIMILARITY_MAX_ANALYSIS_ATTEMPTS=5
SIMILARITY_RETRY_BASE_MINUTES=10

# --- Event summaries (after grouping, inside the ingestion graph) -----------
# Off by default. When true, the worker summarizes every event a new record is
# linked to, right after the record and its grouping are committed. Needs
# SIMILARITY_ENABLED=true, migration 004 (`uv run datasources-db migrate`) and
# Anthropic credentials (the same ANTHROPIC_API_KEY as comparison). Summary
# failures never affect the stored article; the work is retried from
# event_summary_job (`uv run datasources-summary retry`).
SUMMARY_ENABLED=false
SUMMARY_BACKEND=anthropic
# Configured separately from SIMILARITY_COMPARISON_MODEL.
SUMMARY_MODEL=claude-opus-5
# Empty = the model's default effort. One of: low, medium, high, xhigh, max.
SUMMARY_EFFORT=
SUMMARY_FALLBACKS=default
# Only English is generated (storage keeps a language code per summary).
SUMMARY_LANGUAGE=en
SUMMARY_LLM_TIMEOUT_SECONDS=120
# SDK retries per request (408/409/429/5xx, connection errors).
SUMMARY_LLM_MAX_RETRIES=2
# A ceiling, not a target: also covers the model's thinking.
SUMMARY_MAX_OUTPUT_TOKENS=16000
# Bounded evidence: whole passages only; what does not fit is recorded.
SUMMARY_MAX_INPUT_CHARS=24000
SUMMARY_MAX_PASSAGES=40
# Cost cap: summary requests per graph run (one ingested record) and per CLI command.
SUMMARY_MAX_REQUESTS_PER_RUN=5
# Durable retries of failed summary work: attempts, then exponential backoff.
SUMMARY_MAX_ATTEMPTS=4
SUMMARY_RETRY_BASE_MINUTES=10
# A crashed process's lease on a summary job expires after this long.
SUMMARY_LEASE_MINUTES=10
