ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_NEWS_SYMBOLS=NVDA
# Copy this file to `.env` and fill in your Alpaca credentials.
# Get keys at https://app.alpaca.markets/ (Paper trading keys work for news).
# If these are absent, the Alpaca endpoint falls back to a bundled sample
# response so the frontend still works for data exploration.

# Optional: SEC EDGAR requires a descriptive User-Agent (fair-access policy).
# Format: "AppName contact@email.com". Defaults to a generic value if unset.
SEC_USER_AGENT=StudentResearchProject nathan.kittichai@gmail.com
