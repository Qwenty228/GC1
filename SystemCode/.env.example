# Copy this file to `.env` and fill in your values. Never commit `.env`.
# No LLM or other AI key is used by this project.

# --- Alpaca authentication -------------------------------------------------
# trading (default): Trading API keys sent as APCA-API-KEY-ID / APCA-API-SECRET-KEY.
# broker: OAuth2 client-credentials token (Authorization: Bearer), cached ~15 min.
ALPACA_AUTH_MODE=trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Only for ALPACA_AUTH_MODE=broker:
ALPACA_BROKER_CLIENT_ID=
ALPACA_BROKER_CLIENT_SECRET=
# ALPACA_BROKER_TOKEN_URL=https://authx.alpaca.markets/v1/oauth2/token

# Symbols for the standalone stream (datasources-news-stream). The ingestion
# worker uses INGEST_SYMBOLS, falling back to this value, then NVDA.
ALPACA_NEWS_SYMBOLS=NVDA

# --- SEC EDGAR --------------------------------------------------------------
# Required for live SEC access (fair-access policy): "AppName contact@email.com".
SEC_USER_AGENT=YourAppName you@example.com
# Forms to ingest; amendments stay separate filings.
SEC_FORMS=8-K,8-K/A
# Poll each configured company roughly this often (seconds).
SEC_POLL_INTERVAL_SECONDS=60
# Shared budget for ALL SEC requests from the worker (SEC's limit is 10/s; max 5 allowed here).
SEC_REQUESTS_PER_SECOND=2
# First run inspects filings filed within this many days.
SEC_INITIAL_LOOKBACK_DAYS=30
# Recovery never inspects filings older than this many days.
SEC_RECOVERY_MAX_DAYS=365
# Max older submissions files fetched when the recovery range needs them.
SEC_MAX_HISTORICAL_FILES=2
SEC_MAX_RETRIES=3
SEC_MAX_DOCUMENT_BYTES=15728640
SEC_MAX_SUBMISSIONS_BYTES=62914560

# --- Ingestion worker -------------------------------------------------------
INGEST_SYMBOLS=NVDA
# Live output root; demo data always goes to <INGEST_OUTPUT_DIR>/demo.
INGEST_OUTPUT_DIR=output
INGEST_DEMO_MODE=false
INGEST_QUEUE_SIZE=200
HTTP_TIMEOUT_SECONDS=30

# Alpaca REST backfill / reconnect recovery
ALPACA_INITIAL_LOOKBACK_HOURS=24
ALPACA_RECONNECT_OVERLAP_MINUTES=15
ALPACA_RECOVERY_MAX_HOURS=72
ALPACA_BACKFILL_MAX_PAGES=40
# Documented maximum is 50.
ALPACA_PAGE_SIZE=50

# --- Web UI -----------------------------------------------------------------
# true = /api/alpaca serves the bundled SYNTHETIC sample instead of live data.
# Missing credentials are otherwise reported as a configuration error.
DATASOURCES_DEMO_MODE=false
